# 应用
APP_NAME=销售赋能AI系统
APP_ENV=dev
# true：无 Authorization 时可用 X-Debug-User-Id 兜底。生产必须 false。
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000

# PostgreSQL
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password
POSTGRES_DB=sales_ai

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# JWT
JWT_SECRET_KEY=please_change_me
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=120

# AI 网关（默认 mock。remote 走 AI_REMOTE_BASE_URL）
AI_MODE=mock
AI_GATEWAY_BASE_URL=http://127.0.0.1:9000
AI_REMOTE_BASE_URL=http://127.0.0.1:9000
# remote：/v1/reply/stream /v1/tags/recommend /v1/schedules/parse /v1/asr
AI_TIMEOUT_SECONDS=3

# 企业微信
WECOM_CORP_ID=
WECOM_AGENT_ID=
WECOM_SECRET=

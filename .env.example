# 应用
APP_NAME=销售赋能AI系统
APP_ENV=dev
# true：无 Authorization 时可用 X-Debug-User-Id 兜底。生产必须 false。
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000

# PostgreSQL
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password
POSTGRES_DB=sales_ai

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# JWT
JWT_SECRET_KEY=please_change_me
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=120

# AI 网关（默认 mock。remote 指向独立模块 ai_runtime，默认 :9000）
# 联调：先起 ai_runtime（见 ai_runtime/README.md 或 scripts/start-ai.ps1），再设 AI_MODE=remote
AI_MODE=mock
AI_GATEWAY_BASE_URL=http://127.0.0.1:9000
AI_REMOTE_BASE_URL=http://127.0.0.1:9000
# remote：/v1/reply/stream /v1/tags/recommend /v1/schedules/parse /v1/asr
# DeepSeek 流式首字可能较慢，建议 8～15
AI_TIMEOUT_SECONDS=8

# 二期：RAG / Agent
RAG_SCORE_THRESHOLD=0.35
AGENT_MAX_STEPS=3
AGENT_TIMEOUT_SECONDS=5
KB_UPLOAD_DIR=data/kb_uploads
KB_VECTOR_DIR=data/kb_vectors
VECTOR_SEARCH_WEIGHT=0.65

# 企业微信
WECOM_CORP_ID=
WECOM_AGENT_ID=
WECOM_SECRET=
WECOM_CALLBACK_TOKEN=
WECOM_ENCODING_AES_KEY=
WECOM_API_BASE_URL=https://qyapi.weixin.qq.com

# 可观测（阶段 G）
LOG_LEVEL=INFO
# false：不启 OpenTelemetry；true 时无 Collector 用 ConsoleExporter，不阻塞启动
OTEL_ENABLED=false
OTEL_SERVICE_NAME=sales-ai
OTEL_EXPORTER_OTLP_ENDPOINT=

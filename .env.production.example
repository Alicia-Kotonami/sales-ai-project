# 复制为 .env.production 后填写真实值。不要提交 .env.production。
# 启动：docker compose -f docker-compose.prod.yml --env-file .env.production up -d --build

# 应用
APP_NAME=销售赋能AI系统
APP_ENV=prod
APP_DEBUG=false
APP_HOST=0.0.0.0
APP_PORT=8000

# PostgreSQL（容器内主机名必须是 compose 服务名 postgres）
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=salesai
POSTGRES_PASSWORD=please_change_me
POSTGRES_DB=salesai

# Redis（容器内主机名必须是 compose 服务名 redis）
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# JWT（生产必须换成足够长的随机串）
JWT_SECRET_KEY=please_change_me_use_a_long_random_string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=120

# AI 网关（默认 mock；remote 调用 /v1/reply/stream /v1/tags/recommend /v1/schedules/parse /v1/asr）
AI_MODE=mock
AI_GATEWAY_BASE_URL=http://127.0.0.1:9000
AI_REMOTE_BASE_URL=http://127.0.0.1:9000
AI_TIMEOUT_SECONDS=3

# 企业微信（回调 Token / EncodingAESKey / Secret 不要用示例值）
WECOM_CORP_ID=
WECOM_AGENT_ID=
WECOM_SECRET=
WECOM_CALLBACK_TOKEN=
WECOM_ENCODING_AES_KEY=
WECOM_API_BASE_URL=https://qyapi.weixin.qq.com
